# SensADS — Variables d'environnement (template)
#
# Copie ce fichier vers .env.local et remplis les valeurs.
# Ne JAMAIS committer .env.local ni de vraies valeurs ici.

# ============================================
# SUPABASE — Frontend (Vite)
# ============================================
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================
# APP CONFIG
# ============================================
VITE_APP_ENV=development
VITE_APP_VERSION=0.1.0
VITE_APP_URL=http://localhost:5173

# ============================================
# SUPABASE — Edge Functions / Server-side
# (à configurer via `supabase secrets set ...`)
# ============================================
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_DB_URL=

# Meta API (pour Edge Functions meta-oauth, meta-refresh-tokens, meta-webhook)
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=

# Encryption (pour pgcrypto sym keys)
# PGCRYPTO_KEY=

# Backup
# BACKUP_GPG_PUBLIC_KEY=

# Hostinger SMTP (email transactionnel)
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@sensads.com
